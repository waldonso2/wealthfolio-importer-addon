{
  "name": "broker-importer-addon",
  "version": "2.11.0",
  "description": "Import Trade Republic and Scalable Capital CSV exports and PDF statements (incl. DKB) into Wealthfolio",
  "type": "module",
  "main": "dist/addon.js",
  "author": "waldonso2",
  "license": "MIT",
  "homepage": "https://github.com/waldonso2/wealthfolio-importer-addon",
  "repository": {
    "type": "git",
    "url": "https://github.com/waldonso2/wealthfolio-importer-addon.git"
  },
  "keywords": [
    "wealthfolio",
    "addon",
    "trade-republic",
    "scalable-capital",
    "importer",
    "csv",
    "pdf",
    "dkb"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "dev:server": "wealthfolio dev",
    "clean": "rm -rf dist",
    "bundle": "pnpm build && zip dist/broker-importer-addon.zip manifest.json dist/addon.js README.md",
    "lint": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "papaparse": "^5.7.0",
    "pdfjs-dist": "4.10.38"
  },
  "peerDependencies": {
    "@wealthfolio/addon-sdk": "^3.7.0",
    "@wealthfolio/ui": "^3.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "@wealthfolio/addon-dev-tools": "^3.7.0",
    "@wealthfolio/addon-sdk": "^3.7.0",
    "@wealthfolio/ui": "^3.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "files": [
    "dist/",
    "manifest.json",
    "README.md"
  ]
}
